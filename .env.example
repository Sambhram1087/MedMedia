# ---- Required ----
DATABASE_URL=postgres://med:med@localhost:5432/medmedia
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Common ----
NODE_ENV=development
PORT=5000
# Comma separated emails that become admins (can approve doctor/student verification)
ADMIN_EMAILS=you@example.com
# Only needed if the web app is hosted on a different domain than the API
CORS_ORIGINS=
# Set to true for most managed Postgres providers that require SSL
DB_SSL=false
# Keep (instances x DB_POOL_MAX) below your database's max connections
DB_POOL_MAX=10

# ---- File storage ----
# local = files on disk (needs a persistent volume in production)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO) - recommended
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# PUBLIC bucket for images and clips (readable by anyone with the link)
S3_BUCKET=
# PRIVATE bucket for credential documents. Must be a different bucket and must NOT be public.
S3_PRIVATE_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the PUBLIC bucket (R2 public domain, CloudFront, or the bucket's public URL), no trailing slash
S3_PUBLIC_BASE_URL=

# ---- Tuning ----
# Leave unset in production. Set to false only to test the production build over http://localhost
# COOKIE_SECURE=false
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_15MIN=30
